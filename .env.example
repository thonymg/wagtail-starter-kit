# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and adjust values for your environment.
# Never commit .env — it is listed in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# Database driver: sqlite (default, no extra setup) | postgres | mysql
DATABASE=sqlite

# ── Django ────────────────────────────────────────────────────────────────────
# Generate a strong key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DEBUG=false

# ── Wagtail ───────────────────────────────────────────────────────────────────
WAGTAIL_SITE_NAME=wagtail-starter-kit
WAGTAILADMIN_BASE_URL=http://localhost:8000

# ── PostgreSQL (DATABASE=postgres) ────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# ── MySQL (DATABASE=mysql) ────────────────────────────────────────────────────
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=app
MYSQL_ROOT_HOST=%
